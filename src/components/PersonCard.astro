---
import { Image } from 'astro:assets';
import watercolor from '../assets/hero/watercolor.webp?url';

interface Person {
  name: string;
  role: string;
  bio: string;
  slug: string;
  website?: string;
  twitter?: string;
  linkedin?: string;
  huggingface?: string;
  github?: string;
  google_scholar?: string;
}
interface Props {
  person: Person;
  variant?: 'team' | 'advisor';
  headingLevel?: 3 | 4;
  class?: string;
}
const { person, variant = 'advisor', headingLevel = 3, class: className = '' } = Astro.props;
const Heading = headingLevel === 3 ? 'h3' : 'h4';

const photos = import.meta.glob<{ default: ImageMetadata }>(
  ['../assets/people/*.webp', '../assets/people/*.png'],
  { eager: true },
);
const photo =
  photos[`../assets/people/${person.slug}.webp`]?.default ??
  photos[`../assets/people/${person.slug}.png`]?.default;
if (!photo) {
  throw new Error(
    `Missing photo for "${person.slug}" — add src/assets/people/${person.slug}.webp or .png`,
  );
}

function getFraming(name: string): string {
  const lower = name.toLowerCase();
  if (lower.includes('yonatan')) return 'scale-[1.34] origin-[center_16%]';
  if (lower.includes('mario') || lower.includes('seraphina')) return 'object-[center_62%] scale-[1.12]';
  return 'object-[center_28%]';
}
const framing = getFraming(person.name);

const socials = (
  [
    { key: 'website', label: 'Website' },
    { key: 'google_scholar', label: 'Google Scholar' },
    { key: 'twitter', label: 'X / Twitter' },
    { key: 'linkedin', label: 'LinkedIn' },
    { key: 'github', label: 'GitHub' },
    { key: 'huggingface', label: 'Hugging Face' },
  ] as const
)
  .map((social) => ({ ...social, url: person[social.key] }))
  .filter((social): social is typeof social & { url: string } => !!social.url);
---

<article data-person={person.slug} class:list={['person-card group/person min-w-0', variant === 'team' ? 'max-w-[300px]' : 'max-w-[240px]', className]} style={`--portrait-watercolor: url('${watercolor}')`}>
  <div class:list={['portrait-composition', variant === 'team' ? 'portrait-team' : 'portrait-advisor']}>
    <svg class="portrait-orbit" viewBox="0 0 240 240" fill="none" aria-hidden="true">
      <circle cx="120" cy="120" r="109" stroke="currentColor" stroke-width="0.9" stroke-dasharray="0.8 4" stroke-linecap="round" />
      <ellipse cx="120" cy="120" rx="116" ry="103" transform="rotate(-28 120 120)" stroke="currentColor" stroke-width="0.6" opacity="0.55" />
      <circle cx="23.8" cy="171.3" r="2.6" fill="currentColor" />
      <circle cx="217" cy="70.3" r="1.8" fill="currentColor" />
    </svg>
    <div
      class="portrait-image-frame relative mx-auto aspect-square overflow-hidden rounded-full"
    >
      <Image
        src={photo}
        alt={person.name}
        width={720}
        quality={92}
        loading="lazy"
        class:list={[
          'portrait-image absolute inset-0 h-full w-full object-cover',
          framing,
        ]}
      />
    </div>
  </div>

  <div class="person-content text-center">
    <div>
      <Heading class="person-name font-display text-[clamp(20px,2vw,25px)] font-semibold leading-[1.25] tracking-[-0.015em]">
        {person.website ? (
          <a href={person.website} rel="noopener" target="_blank" class="transition-colors hover:text-gold-deep">
            {person.name}
          </a>
        ) : (
          person.name
        )}
      </Heading>
      {variant === 'team' && <p class="person-role mt-0.5 text-[clamp(13px,1.25vw,15px)] font-medium text-ink-2">{person.role}</p>}
      <p class="person-bio mt-1 text-[clamp(14px,1.4vw,16px)] leading-[1.5] text-ink-2">{person.bio}</p>
    </div>

    {socials.length > 0 && (
      <div class="person-socials mt-1.5 flex flex-wrap items-center justify-center gap-1">
        {socials.map((social) => (
          <a
            href={social.url}
            rel="noopener"
            target="_blank"
            aria-label={`${person.name} — ${social.label}`}
            title={social.label}
            class="person-social text-ink-2 transition-colors hover:text-gold-deep"
          >
            <svg class={social.key === 'twitter' ? 'h-[14px] w-[14px]' : 'h-[16px] w-[16px]'} aria-hidden="true">
              <use href={`#icon-${social.key}`} />
            </svg>
          </a>
        ))}
      </div>
    )}
  </div>
</article>

<style>
  .person-card { width: 100%; justify-self: center; }
  .portrait-composition { position: relative; isolation: isolate; width: min(100%, 190px); margin: 12px auto 28px; }
  .portrait-advisor { width: min(100%, 152px); }
  .portrait-composition::before {
    content: '';
    position: absolute;
    inset: -15%;
    z-index: -1;
    background: var(--portrait-watercolor) 83% 84% / 650px auto;
    opacity: 0.25;
    mask-image: radial-gradient(ellipse closest-side, #000 62%, #0008 78%, transparent 100%);
  }
  .portrait-orbit { position: absolute; width: 126%; height: 126%; left: -13%; top: -13%; color: #b28c44; opacity: 0.8; pointer-events: none; transform: rotate(0deg); transition: transform 700ms; }
  .portrait-image-frame { background: #d9d0bb; mask-image: radial-gradient(circle closest-side, #000 88%, #000000e8 94%, #0008 98%, transparent 100%); }
  .person-card:is(:hover, :focus-within) .portrait-orbit { transform: rotate(12deg); }
  .person-social { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; }
  .person-social:hover { background: #b797551a; }
  :global(html.dark) .portrait-composition::before { filter: invert(1) grayscale(1); opacity: 0.28; }
  :global(html.dark) .portrait-orbit { color: #d8b774; opacity: 0.85; }
  :global(html.dark) .portrait-image-frame { background: #d5d6c6; }
  @media (max-width: 600px) {
    .portrait-composition { max-width: 142px; margin-bottom: 25px; }
    .portrait-advisor { max-width: 122px; }
    .person-socials { flex-wrap: nowrap; }
  }
</style>
