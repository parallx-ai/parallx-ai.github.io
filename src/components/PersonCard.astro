---
import { Image } from 'astro:assets';

interface Person {
  name: string;
  role: string;
  bio: string;
  slug: string;
  website?: string;
  twitter?: string;
  linkedin?: string;
  huggingface?: string;
  github?: string;
  google_scholar?: string;
}
interface Props {
  person: Person;
  variant?: 'team' | 'advisor';
  headingLevel?: 3 | 4;
  class?: string;
}
const { person, variant = 'advisor', headingLevel = 3, class: className = '' } = Astro.props;
const Heading = headingLevel === 3 ? 'h3' : 'h4';

const photos = import.meta.glob<{ default: ImageMetadata }>(
  ['../assets/people/*.webp', '../assets/people/*.png'],
  { eager: true },
);
const photo =
  photos[`../assets/people/${person.slug}.webp`]?.default ??
  photos[`../assets/people/${person.slug}.png`]?.default;
if (!photo) {
  throw new Error(
    `Missing photo for "${person.slug}" — add src/assets/people/${person.slug}.webp or .png`,
  );
}

function getFraming(name: string): string {
  const lower = name.toLowerCase();
  if (lower.includes('yonatan')) return 'scale-[1.34] origin-[center_16%]';
  if (lower.includes('mario') || lower.includes('seraphina')) return 'object-[center_62%] scale-[1.12]';
  return 'object-[center_28%]';
}
const framing = getFraming(person.name);

const socials = (
  [
    { key: 'website', label: 'Website' },
    { key: 'google_scholar', label: 'Google Scholar' },
    { key: 'twitter', label: 'X / Twitter' },
    { key: 'linkedin', label: 'LinkedIn' },
    { key: 'github', label: 'GitHub' },
    { key: 'huggingface', label: 'Hugging Face' },
  ] as const
)
  .map((social) => ({ ...social, url: person[social.key] }))
  .filter((social): social is typeof social & { url: string } => !!social.url);
---

<article data-person={person.slug} class:list={['group/person min-w-0', variant === 'team' ? 'max-w-[250px]' : 'max-w-[220px]', className]}>
  <div class="relative mb-4">
    <div
      class:list={[
        'relative mx-auto aspect-square overflow-hidden rounded-full border border-rule bg-paper',
        variant === 'team' ? 'w-full max-w-[160px] max-xs:max-w-[124px]' : 'w-full max-w-[132px] max-xs:max-w-[112px]',
      ]}
    >
      <Image
        src={photo}
        alt={person.name}
        width={720}
        quality={92}
        loading="lazy"
        class:list={[
          'absolute inset-0 h-full w-full object-cover [filter:saturate(0.78)_contrast(0.98)] transition duration-500 group-hover/person:[filter:saturate(0.96)_contrast(1)]',
          framing,
        ]}
      />
    </div>
  </div>

  <div class="border-b border-rule-soft pb-3 text-center">
    <div>
      <Heading class="font-display text-[clamp(20px,2vw,24px)] font-semibold leading-[1.35] tracking-[-0.015em]">
        {person.website ? (
          <a href={person.website} rel="noopener" target="_blank" class="transition-colors hover:text-gold-deep">
            {person.name}
          </a>
        ) : (
          person.name
        )}
      </Heading>
      {variant === 'team' && <p class="mt-1 text-[clamp(13px,1.25vw,15px)] font-medium text-ink-2">{person.role}</p>}
      <p class="mt-1 text-[clamp(14px,1.4vw,17px)] leading-[1.45] text-ink-3">{person.bio}</p>
    </div>

    {socials.length > 0 && (
      <div class="mt-2 flex flex-wrap items-center justify-center gap-2">
        {socials.map((social) => (
          <a
            href={social.url}
            rel="noopener"
            target="_blank"
            aria-label={`${person.name} — ${social.label}`}
            title={social.label}
            class="text-ink-3 transition-colors hover:text-gold-deep"
          >
            <svg class={social.key === 'twitter' ? 'h-[14px] w-[14px]' : 'h-[16px] w-[16px]'} aria-hidden="true">
              <use href={`#icon-${social.key}`} />
            </svg>
          </a>
        ))}
      </div>
    )}
  </div>
</article>
