---
interface Props {
  role: string;
  href: string;
}

const { role, href } = Astro.props;
---

<div class="apply-action">
  <a
    class="apply-button"
    href={href}
    aria-label={`Apply to this position: ${role}`}
  >
    Apply to this position
  </a>
</div>

<style>
  .apply-action {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .apply-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 9999px;
    background: var(--color-gold-button);
    color: white;
    cursor: pointer;
    font-family: inherit;
    font-size: 16px;
    font-weight: 600;
    line-height: 1;
    padding: 0.875rem 1.625rem;
    opacity: 1;
    text-decoration: none;
  }

  .apply-button:hover {
    color: white;
    border: 0;
  }
</style>
