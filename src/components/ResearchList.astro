---
import { Image } from 'astro:assets';
import Container from './Container.astro';
import orgs from '../data/orgs.json';

interface NewsItem {
  org: string;
  url: string;
}
interface ResearchItem {
  title: string;
  year: number;
  author_short: string;
  text: string;
  venue?: string;
  tags: string[];
  collaboration?: string[];
  news?: NewsItem[];
  figure?: string;
  paper_link?: string;
  code_link?: string;
  data_link?: string;
  demo_link?: string;
}
interface Props {
  items: ResearchItem[];
}
const { items } = Astro.props;

// Bundled at build by Astro: every WebP under src/assets/orgs/ (used for
// logo masks in the collaboration/news badges) and src/assets/img/ (full figure thumbnails).
// The glob imports yield ImageMetadata; .src is the final hashed URL that
// mask:url() needs, while figure thumbnails are passed to <Image> so they get
// an optimised srcset.
const orgLogos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/orgs/*.webp',
  { eager: true },
);
const figureImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/img/*.webp',
  { eager: true },
);
function getLogoUrl(slug: string): string {
  const meta = orgLogos[`../assets/orgs/${slug}.webp`]?.default;
  if (!meta) {
    throw new Error(`Missing logo for "${slug}" — add src/assets/orgs/${slug}.webp`);
  }
  return meta.src;
}
function getFigure(filename: string): ImageMetadata {
  const meta = figureImages[`../assets/img/${filename}`]?.default;
  if (!meta) {
    throw new Error(`Missing figure "${filename}" — add src/assets/img/${filename}`);
  }
  return meta;
}

// Collaboration and news organization slugs find their matching logo here.
const orgsBySlug: Record<string, { name: string; logo: string; website: string }> =
  Object.fromEntries(
    orgs.map((o) => [
      o.slug.toLowerCase(),
      { name: o.name, logo: getLogoUrl(o.slug), website: o.website ?? '' },
    ]),
  );

// `figure` may be either a short caption ("ATTRIBUTION GRAPH") or a filename
// like "cognitive_maps.webp" resolved against src/assets/img/; treat anything
// that ends in an image extension as an actual image. Typed as a type guard
// so callers get narrowed `string` (not `string | undefined`).
const isImagePath = (s?: string): s is string =>
  !!s && /\.(png|jpe?g|webp|svg|gif)$/i.test(s);
const sentenceLabel = (text: string) =>
  text.charAt(0).toUpperCase() + text.slice(1).toLowerCase();
---
<section id="research" class="scroll-mt-[76px] py-24 max-nav:py-16">
  <Container>
    <div class="mb-14 max-nav:mb-9">
      <h2 class="text-balance font-display text-[clamp(20px,3vw,36px)] font-semibold leading-[1.05] tracking-[-0.035em]">
        Our Work
      </h2>
      <p class="mt-4 text-[clamp(17px,1.4vw,21px)] leading-[1.5]">
        We study how agents encode latent beliefs, goals, and plans, and how these shape their behaviour.
      </p>
    </div>

    <div class="grid gap-5">
      {
        items.map((item) => (
          <article class="group/card grid grid-cols-[minmax(0,19rem)_minmax(0,1fr)] items-center gap-[clamp(18px,2.5vw,36px)] border border-rule-soft bg-paper/75 p-[clamp(20px,2.5vw,34px)] transition-[transform,border-color,background-color,box-shadow] duration-300 hover:-translate-y-0.5 hover:border-gold/50 hover:bg-paper hover:shadow-[0_14px_34px_rgba(17,20,17,0.08)] max-[760px]:grid-cols-1 max-[760px]:gap-5 dark:hover:shadow-[0_14px_34px_rgba(0,0,0,0.22)]">
            <div class="min-w-0">
              <div class="mb-1 text-[clamp(13px,1.25vw,15px)] font-medium text-ink-2">
                {[item.year, item.author_short, item.venue].filter(Boolean).join(' · ')}
              </div>
              <h3 class="mt-1.5 mb-2.5 font-display text-[clamp(20px,2vw,24px)] font-semibold leading-[1.35] tracking-[-0.015em]">
                {item.paper_link ? (
                  <a
                    href={item.paper_link}
                    rel="noopener"
                    target="_blank"
                    class="underline decoration-rule decoration-1 underline-offset-4 transition-colors hover:text-gold-deep hover:decoration-gold"
                  >
                    {item.title}
                  </a>
                ) : (
                  item.title
                )}
              </h3>
              <p class="m-0 text-[clamp(14px,1.4vw,17px)] leading-[1.45] text-ink-1">{item.text}</p>
              {item.news && item.news.length > 0 && (
                <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-[clamp(12.5px,1.15vw,14px)] font-medium text-ink-2">
                  <span>Covered by</span>
                  {item.news.map((n) => {
                    if (!n || typeof n.org !== 'string') return null;
                    const org = orgsBySlug[n.org.toLowerCase()];
                    if (!org) return null;
                    const maskStyle = `mask:url(${org.logo}) center / contain no-repeat;-webkit-mask:url(${org.logo}) center / contain no-repeat;`;
                    return (
                      <a
                        href={n.url || '#'}
                        rel="noopener"
                        target="_blank"
                        aria-label={org.name}
                        title={org.name}
                        class="group/news inline-block"
                      >
                        <span
                          aria-hidden="true"
                          class="inline-block bg-ink opacity-80 transition-colors group-hover/news:bg-gold-deep group-hover/news:opacity-100"
                          style={maskStyle}
                        >
                          <img
                            src={org.logo}
                            alt=""
                            aria-hidden="true"
                            class="block h-6 max-w-[120px] opacity-0"
                          />
                        </span>
                      </a>
                    );
                  })}
                </div>
              )}
            </div>
            {isImagePath(item.figure) ? (
              <div
                class="order-first flex max-w-full justify-self-center items-center justify-center overflow-hidden bg-transparent p-2"
                style={`width:${((12 * getFigure(item.figure).width) / getFigure(item.figure).height).toFixed(3)}rem;aspect-ratio:${getFigure(item.figure).width} / ${getFigure(item.figure).height}`}
                aria-hidden="true"
              >
                {item.paper_link ? (
                  /* Redundant with the title link, so keep it out of the tab
                     order (the wrapper is already aria-hidden) — mouse users
                     can still click the figure to reach the paper. */
                  <a
                    href={item.paper_link}
                    rel="noopener"
                    target="_blank"
                    tabindex="-1"
                    class="flex h-full w-full items-center justify-center transition-opacity hover:opacity-90"
                  >
                    <Image
                      src={getFigure(item.figure)}
                      alt=""
                      width={420}
                      densities={[1, 2, 3]}
                      loading="lazy"
                      class="block h-full w-full object-contain"
                    />
                  </a>
                ) : (
                  <Image
                    src={getFigure(item.figure)}
                    alt=""
                    width={420}
                    densities={[1, 2, 3]}
                    loading="lazy"
                    class="block h-full w-full object-contain"
                  />
                )}
              </div>
            ) : (
              <div
                class="relative order-first flex aspect-[19/12] w-full max-w-[19rem] justify-self-center items-center justify-center overflow-hidden bg-transparent p-2"
                aria-hidden="true"
              >
                <div class="absolute inset-0 bg-[repeating-linear-gradient(-38deg,transparent_0_9px,rgba(0,0,0,0.05)_9px_10px)]" />
                {item.figure && (
                  <span class="relative border border-rule-soft bg-paper px-2.5 py-1 text-[12px] font-medium text-ink-3">
                    {sentenceLabel(item.figure)}
                  </span>
                )}
              </div>
            )}
          </article>
        ))
      }
    </div>

    <!-- <div class="mt-9 flex items-center justify-end">
      <Button href="#" variant="ghost">See all publications</Button>
    </div> -->
  </Container>
</section>
