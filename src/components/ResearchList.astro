---
import { Image } from 'astro:assets';
import Container from './Container.astro';
import watercolor from '../assets/hero/watercolor.webp?url';
import orgs from '../data/orgs.json';

interface NewsItem {
  org: string;
  url: string;
}
interface ResearchItem {
  title: string;
  year: number;
  author_short: string;
  text: string;
  venue?: string;
  tags: string[];
  collaboration?: string[];
  news?: NewsItem[];
  figure?: string;
  paper_link?: string;
  code_link?: string;
  data_link?: string;
  demo_link?: string;
}
interface Props {
  items: ResearchItem[];
}
const { items } = Astro.props;

// Bundled at build by Astro: every WebP under src/assets/orgs/ (used for
// logo masks in the collaboration/news badges) and src/assets/img/ (full figure thumbnails).
// The glob imports yield ImageMetadata; .src is the final hashed URL that
// mask:url() needs, while figure thumbnails are passed to <Image> so they get
// an optimised srcset.
const orgLogos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/orgs/*.webp',
  { eager: true },
);
const figureImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/img/*.webp',
  { eager: true },
);
function getLogoUrl(slug: string): string {
  const meta = orgLogos[`../assets/orgs/${slug}.webp`]?.default;
  if (!meta) {
    throw new Error(`Missing logo for "${slug}" — add src/assets/orgs/${slug}.webp`);
  }
  return meta.src;
}
function getFigure(filename: string): ImageMetadata {
  const meta = figureImages[`../assets/img/${filename}`]?.default;
  if (!meta) {
    throw new Error(`Missing figure "${filename}" — add src/assets/img/${filename}`);
  }
  return meta;
}

// Collaboration and news organization slugs find their matching logo here.
const orgsBySlug: Record<string, { name: string; logo: string; website: string }> =
  Object.fromEntries(
    orgs.map((o) => [
      o.slug.toLowerCase(),
      { name: o.name, logo: getLogoUrl(o.slug), website: o.website ?? '' },
    ]),
  );

// `figure` may be either a short caption ("ATTRIBUTION GRAPH") or a filename
// like "cognitive_maps.webp" resolved against src/assets/img/; treat anything
// that ends in an image extension as an actual image. Typed as a type guard
// so callers get narrowed `string` (not `string | undefined`).
const isImagePath = (s?: string): s is string =>
  !!s && /\.(png|jpe?g|webp|svg|gif)$/i.test(s);
const sentenceLabel = (text: string) =>
  text.charAt(0).toUpperCase() + text.slice(1).toLowerCase();
---
<section id="research" class="research-section scroll-mt-[76px] py-24 max-nav:py-16" style={`--section-watercolor: url('${watercolor}')`}>
  <Container>
    <div class="research-heading mb-14 max-nav:mb-9">
      <h2 class="text-balance font-display text-[clamp(30px,3.5vw,46px)] font-semibold leading-[1.05] tracking-[-0.035em]">
        Our Work
      </h2>
      <p class="mt-4 text-[clamp(17px,1.4vw,21px)] leading-[1.5]">
        We study how agents encode latent beliefs, goals, and plans, and how these shape their behaviour.
      </p>
    </div>

    <div class="work-grid">
      {
        items.map((item, index) => (
          <article class:list={['work-card', { 'work-card-lead': index === 0 }]}>
            <div class="work-copy">
              <div class="work-meta">
                {[item.year, item.author_short, item.venue].filter(Boolean).join(' · ')}
              </div>
              <h3 class="work-title">
                {item.paper_link ? (
                  <a
                    href={item.paper_link}
                    rel="noopener"
                    target="_blank"
                    class="work-title-link"
                  >
                    {item.title}
                  </a>
                ) : (
                  item.title
                )}
              </h3>
              <p class="work-summary">{item.text}</p>
              {item.news && item.news.length > 0 && (
                <div class="work-coverage mt-4 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-[13px] font-medium text-ink-2">
                  <span>Covered by</span>
                  {item.news.map((n) => {
                    if (!n || typeof n.org !== 'string') return null;
                    const org = orgsBySlug[n.org.toLowerCase()];
                    if (!org) return null;
                    const maskStyle = `mask:url(${org.logo}) center / contain no-repeat;-webkit-mask:url(${org.logo}) center / contain no-repeat;`;
                    return (
                      <a
                        href={n.url || '#'}
                        rel="noopener"
                        target="_blank"
                        aria-label={org.name}
                        title={org.name}
                        class="group/news inline-block"
                      >
                        <span
                          aria-hidden="true"
                          class="inline-block bg-ink opacity-80 transition-colors group-hover/news:bg-gold-deep group-hover/news:opacity-100"
                          style={maskStyle}
                        >
                          <img
                            src={org.logo}
                            alt=""
                            aria-hidden="true"
                            class="block h-6 max-w-[120px] opacity-0"
                          />
                        </span>
                      </a>
                    );
                  })}
                </div>
              )}
              <div class="work-resources">
                {item.paper_link && <a href={item.paper_link} target="_blank" rel="noopener">Read paper <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 12 12 4M4 4h8v8" stroke="currentColor" stroke-width="1.3" /></svg></a>}
                {item.code_link && <a href={item.code_link} target="_blank" rel="noopener">Code</a>}
                {item.data_link && <a href={item.data_link} target="_blank" rel="noopener">Data</a>}
                {item.demo_link && <a href={item.demo_link} target="_blank" rel="noopener">Demo</a>}
              </div>
            </div>
            {isImagePath(item.figure) ? (
              <div
                class:list={['work-figure', { 'work-illustration': item.figure !== 'cognitive_maps.webp' }]}
                aria-hidden="true"
              >
                <svg class="figure-orbit" viewBox="0 0 400 280" fill="none" aria-hidden="true"><ellipse cx="200" cy="140" rx="189" ry="115" transform="rotate(-12 200 140)" /><path d="M9 157C111 84 311 185 391 113" /><circle cx="30" cy="198" r="3" /></svg>
                {item.paper_link ? (
                  /* Redundant with the title link, so keep it out of the tab
                     order (the wrapper is already aria-hidden) — mouse users
                     can still click the figure to reach the paper. */
                  <a
                    href={item.paper_link}
                    rel="noopener"
                    target="_blank"
                    tabindex="-1"
                    class="work-figure-link"
                  >
                    <Image
                      src={getFigure(item.figure)}
                      alt=""
                      width={420}
                      densities={[1, 2, 3]}
                      loading="lazy"
                      class="work-image"
                    />
                  </a>
                ) : (
                  <Image
                    src={getFigure(item.figure)}
                    alt=""
                    width={420}
                    densities={[1, 2, 3]}
                    loading="lazy"
                    class="work-image"
                  />
                )}
              </div>
            ) : (
              <div
                class="work-figure"
                aria-hidden="true"
              >
                <div class="absolute inset-0 bg-[repeating-linear-gradient(-38deg,transparent_0_9px,rgba(0,0,0,0.05)_9px_10px)]" />
                {item.figure && (
                  <span class="relative border border-rule-soft bg-paper px-2.5 py-1 text-[12px] font-medium text-ink-3">
                    {sentenceLabel(item.figure)}
                  </span>
                )}
              </div>
            )}
          </article>
        ))
      }
    </div>

  </Container>
</section>

<style>
  .research-section { position: relative; }
  .research-heading { max-width: 750px; }
  .work-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px; }
  .work-card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid #c6b99b80;
    border-radius: 4px;
    background: #fbf8f0;
    box-shadow: 0 5px 20px #30281806;
    transition: border-color 250ms;
  }
  .work-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--section-watercolor) 18% 14% / 1600px auto;
    opacity: 0.3;
    pointer-events: none;
  }
  .work-card:is(:hover, :focus-within) { border-color: #b48c42; }
  .work-copy { display: flex; flex: 1; flex-direction: column; align-items: flex-start; padding: 30px 34px 28px; }
  .work-meta { font-size: 13px; line-height: 1.5; color: var(--color-ink-2); }
  .work-title { margin: 12px 0; font-family: var(--font-display); font-size: clamp(24px, 2.4vw, 30px); font-weight: 600; line-height: 1.16; letter-spacing: -0.025em; text-wrap: balance; }
  .work-title-link { transition: color 200ms; }
  .work-summary { margin: 0; font-size: 16px; line-height: 1.6; color: var(--color-ink-1); }
  .work-resources { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 22px; width: 100%; margin-top: auto; padding-top: 26px; }
  .work-resources a { display: inline-flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 500; color: var(--color-gold-deep); text-decoration: underline; text-underline-offset: 5px; text-decoration-color: #b7975555; }
  .work-resources a:hover { text-decoration-color: currentColor; }
  .work-resources svg { width: 14px; height: 14px; }
  .work-figure {
    position: relative;
    display: flex;
    order: -1;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 275px;
    padding: 30px;
    isolation: isolate;
    overflow: hidden;
    background: #eee8da;
  }
  .work-figure::before { content: ''; position: absolute; inset: 0; background: var(--section-watercolor) 38% 56% / 900px auto; opacity: 0.24; z-index: -1; }
  .figure-orbit { position: absolute; inset: 0; margin: auto; width: 96%; height: 96%; color: #aa873c; opacity: 0.43; pointer-events: none; }
  .figure-orbit ellipse, .figure-orbit path { stroke: currentColor; stroke-width: 0.8; stroke-dasharray: 1 4; }
  .figure-orbit circle { fill: currentColor; }
  .work-figure-link { position: relative; display: flex; align-items: center; justify-content: center; height: 100%; width: 100%; }
  .work-image { position: relative; display: block; max-width: 100%; width: auto; height: 100%; object-fit: contain; }
  .work-illustration .work-image { filter: grayscale(1) sepia(0.24) contrast(0.88); mix-blend-mode: multiply; mask-image: linear-gradient(90deg, transparent, #000 2%, #000 98%, transparent); transition: filter 450ms; }
  .work-card:is(:hover, :focus-within) .work-illustration .work-image { filter: grayscale(0) sepia(0) contrast(1); mix-blend-mode: normal; }
  .work-card-lead { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr); }
  .work-card-lead .work-copy { padding: 42px; }
  .work-card-lead .work-figure { height: 100%; min-height: 390px; padding: 44px; }
  .work-card-lead .work-image { height: auto; max-height: 335px; }
  .work-card-lead .work-title { font-size: clamp(26px, 2.6vw, 34px); }
  :global(html.dark) .work-card { background: #1c211d; border-color: #8c795849; box-shadow: none; }
  :global(html.dark) .work-card::before { filter: invert(1) grayscale(1); opacity: 0.12; }
  :global(html.dark) .work-card:is(:hover, :focus-within) { border-color: #b89b5e; }
  @media (max-width: 760px) {
    .work-grid { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .work-card-lead { display: flex; }
    .work-copy, .work-card-lead .work-copy { padding: 27px; }
    .work-figure, .work-card-lead .work-figure { min-height: 0; height: 270px; padding: 27px; }
    .work-card-lead .work-image { max-height: 100%; }
    .work-title, .work-card-lead .work-title { font-size: clamp(23px, 4.8vw, 30px); }
  }
  @media (max-width: 400px) {
    .work-copy, .work-card-lead .work-copy { padding: 22px; }
    .work-figure, .work-card-lead .work-figure { height: 218px; padding: 22px; }
  }
</style>
