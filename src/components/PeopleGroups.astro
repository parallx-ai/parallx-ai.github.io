---
import PersonCard from './PersonCard.astro';
import people from '../data/people.json';

interface Props {
  class?: string;
  headingLevel?: 2 | 3;
}
const { class: className = '', headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const personHeadingLevel: 3 | 4 = headingLevel === 2 ? 3 : 4;
const team = people.filter((person) => person.group === 'team');
const advisors = people.filter((person) => person.group === 'advisors');
---

<div class={className}>
  <section id="team" class="scroll-mt-[92px]" aria-labelledby="our-team-heading">
    <div class="mb-7 border-b border-rule pb-3">
      <Heading id="our-team-heading" class="font-display text-[clamp(20px,3vw,36px)] font-semibold leading-[1.05] tracking-[-0.035em]">Our Team</Heading>
    </div>
    <div data-randomized-founders class="mx-auto grid max-w-[600px] grid-cols-2 gap-x-10 gap-y-12 max-xs:gap-x-5">
      {team.map((person) => <PersonCard person={person} variant="team" headingLevel={personHeadingLevel} />)}
    </div>
  </section>

  <section id="advisors" class="mt-16 scroll-mt-[92px]" aria-labelledby="advisors-heading">
    <div class="mb-7 border-b border-rule pb-3">
      <Heading id="advisors-heading" class="font-display text-[clamp(20px,3vw,36px)] font-semibold leading-[1.05] tracking-[-0.035em]">Advisors</Heading>
    </div>
    <div class="mx-auto grid max-w-[920px] grid-cols-4 gap-x-8 gap-y-12 max-nav:max-w-[600px] max-nav:grid-cols-2 max-xs:gap-x-5">
      {advisors.map((person) => <PersonCard person={person} variant="advisor" headingLevel={personHeadingLevel} />)}
    </div>
  </section>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-randomized-founders]').forEach((teamGrid) => {
    const mario = teamGrid.querySelector<HTMLElement>('[data-person="mario"]');
    const gabriele = teamGrid.querySelector<HTMLElement>('[data-person="gabriele"]');
    if (!mario || !gabriele) return;

    const marioFirst = crypto.getRandomValues(new Uint8Array(1))[0] < 128;
    teamGrid.insertBefore(marioFirst ? mario : gabriele, marioFirst ? gabriele : mario);
  });
</script>
