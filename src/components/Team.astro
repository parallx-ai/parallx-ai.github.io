---
import Container from './Container.astro';
import PeopleGroups from './PeopleGroups.astro';
---
<section id="team" class="border-t border-rule-soft bg-paper py-24 max-nav:py-16">
  <Container>
    <div
      class="mb-14 grid grid-cols-[1fr_2fr] items-start gap-[60px] max-nav:mb-9 max-nav:grid-cols-1 max-nav:gap-4"
    >
      <h2 class="text-balance font-display text-[32px] font-semibold leading-[1.05] tracking-[-0.03em]">
        The people behind Parallax
      </h2>
      <div class="max-w-[58ch] pt-2">
        <p class="mb-4">
          Our core team builds Parallax day to day, supported by advisors across interpretability, evaluation science, and AI safety.
        </p>
      </div>
    </div>
    <PeopleGroups />
  </Container>
</section>
