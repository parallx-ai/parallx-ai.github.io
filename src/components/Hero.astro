---
import Container from './Container.astro';
import HeroSphere from './HeroSphere.astro';
import HeroOrbits from './HeroOrbits.astro';
import HeroRays from './HeroRays.astro';
import watercolor from '../assets/hero/watercolor.webp?url';

const spheres = [
  { x: 12, y: 25, size: 92, duration: 19, delay: -4 },
  { x: 38, y: 13, size: 40, duration: 23, delay: -12 },
  { x: 73, y: 18, size: 76, duration: 21, delay: -7 },
  { x: 92, y: 37, size: 56, duration: 26, delay: -18 },
  { x: 86, y: 71, size: 184, duration: 24, delay: -3 },
  { x: 57, y: 85, size: 54, duration: 20, delay: -9 },
  { x: 27, y: 79, size: 112, duration: 27, delay: -16 },
  { x: 6, y: 63, size: 48, duration: 22, delay: -6 },
];
---

<section id="hero" class="hero" data-running="false" aria-labelledby="hero-title" style={`--watercolor: url('${watercolor}')`}>
  <div class="hero-watercolor" aria-hidden="true"></div>
  <div class="hero-paper" aria-hidden="true"></div>
  <HeroOrbits />

  <div class="hero-spheres" role="group" aria-label="Click the spheres to reveal their inner circuitry, or drag them a little and release">
    {spheres.map((sphere, index) => <HeroSphere {...sphere} index={index} />)}
  </div>
  <HeroRays count={spheres.length} />

  <Container class="hero-content relative z-10 w-full py-20 max-nav:py-14">
    <div class="mx-auto max-w-[780px] text-center">
      <h1 id="hero-title" class="text-balance font-display text-[clamp(44px,5.7vw,76px)] font-semibold leading-[0.98] tracking-[-0.045em] max-xs:text-[clamp(26px,calc(11.3vw-10px),44px)]">
        A <span class="text-gold">deeper look</span> at <span class="whitespace-nowrap">AI agent evaluations</span>
      </h1>
      <p class="mx-auto mt-7 max-w-[640px] text-balance text-[clamp(17px,1.9vw,23px)] leading-[1.5] text-ink">
        Parallax is a non-profit research lab building the science of belief elicitation for white-box auditing of frontier AI agents.
      </p>
    </div>
  </Container>

</section>

<style>
  .hero {
    position: relative;
    display: flex;
    min-height: clamp(700px, calc(100svh - 76px), 900px);
    align-items: center;
    overflow: hidden;
    isolation: isolate;
    background: #f3eee5;
  }
  .hero-watercolor, .hero-paper, .hero-spheres { position: absolute; inset: 0; }
  .hero-watercolor { background: var(--watercolor) center / cover no-repeat; opacity: 0.87; }
  .hero-paper {
    pointer-events: none;
    background: radial-gradient(ellipse 49% 38% at 50% 48%, #f4f1eaa6, #f4f1ea38 65%, transparent);
  }
  .hero :global(.hero-content) { pointer-events: none; }
  .hero h1, .hero p { pointer-events: auto; }
  .hero-spheres { z-index: 2; }
  :global(html.dark) .hero { background: #151a18; }
  :global(html.dark) .hero-watercolor {
    filter: invert(1) grayscale(1) sepia(0.24) hue-rotate(145deg) saturate(0.5);
    opacity: 0.42;
  }
  :global(html.dark) .hero-paper { background: radial-gradient(ellipse 48% 40% at 50% 48%, #151a18d9, #151a185c 65%, transparent); }
  @media (max-width: 1000px) {
    .hero { min-height: 740px; }
  }
  @media (max-width: 600px) {
    .hero { min-height: 720px; }
    .hero-watercolor { background-position: 61% center; }
    .hero-paper { background: radial-gradient(ellipse 75% 37% at 50% 46%, #f4f1ead9, #f4f1ea80 65%, transparent); }
    .hero :global(.hero-content) { transform: translateY(-30px); }
  }
</style>

<script>
  import { initSphereInteractions } from '../scripts/hero-spheres';

  const hero = document.querySelector<HTMLElement>('#hero');
  if (hero) {
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let visible = true;

    function updateMotion() {
      if (!hero) return;
      hero.dataset.running = String(visible && !document.hidden && !reducedMotion.matches);
    }

    initSphereInteractions(hero, reducedMotion);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      updateMotion();
    }, { threshold: 0 }).observe(hero);
    document.addEventListener('visibilitychange', updateMotion);
    reducedMotion.addEventListener('change', updateMotion);
    updateMotion();
  }
</script>
