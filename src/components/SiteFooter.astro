---
import { Image } from 'astro:assets';
import markDark from '../assets/logos/mark-dark-bg.webp';
import Container from './Container.astro';

const year = new Date().getFullYear();
const links = [
  { label: 'X / Twitter', icon: 'twitter', url: 'https://x.com/ParallX_AI' },
  { label: 'Bluesky', icon: 'bluesky', url: 'https://bsky.app/profile/parallx.ai' },
  { label: 'GitHub', icon: 'github', url: 'https://github.com/parallx-ai' },
  { label: 'Hugging Face', icon: 'huggingface', url: 'https://huggingface.co/parallx-ai' },
  { label: 'Email', icon: 'email', url: 'mailto:info@parallx.ai' },
];
---
<footer
  class="bg-[#111] text-[#d9d3c4]"
>
  <Container>
    <div
      class="grid min-h-[96px] grid-cols-[44px_minmax(0,1fr)_auto] items-center gap-x-5 py-5 max-xs:min-h-0 max-xs:grid-cols-[44px_minmax(0,1fr)] max-xs:gap-x-4 max-xs:gap-y-3 max-xs:py-6"
    >
      <a href="/" aria-label="Parallax home" class="shrink-0 self-center">
        <Image src={markDark} alt="" width={44} densities={[1, 2, 3]} loading="lazy" class="block h-11 w-11" />
      </a>
      <p class="m-0 min-w-0 self-center text-[12.5px] leading-[1.55] text-[#aeb4ad]">
        © {year} Parallax <span class="mx-1.5 text-white/25" aria-hidden="true">·</span> Parallax is a sponsored project of <a href="https://www.meridiancambridge.org/" rel="noopener" target="_blank" class="underline decoration-white/20 underline-offset-4 transition-colors hover:text-gold-soft">Meridian Impact CIC</a> (CN: 13653958)
      </p>
      <ul class="m-0 flex shrink-0 list-none items-center gap-0.5 p-0 max-xs:col-span-2 max-xs:row-start-2 max-xs:justify-self-center" aria-label="Parallax links">
        {links.map((link) => (
          <li>
            <a
              href={link.url}
              rel={link.url.startsWith('mailto:') ? undefined : 'noopener'}
              target={link.url.startsWith('mailto:') ? undefined : '_blank'}
              aria-label={link.label}
              title={link.label}
              class="inline-flex p-2 text-[#aeb4ad] transition-colors hover:text-gold-soft"
            >
              <svg class:list={[link.icon === 'twitter' ? 'h-[15px] w-[15px]' : 'h-[17px] w-[17px]']} aria-hidden="true">
                <use href={`#icon-${link.icon}`} />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Container>
</footer>
