---
import { Image } from 'astro:assets';
import wordmark from '../assets/logos/wordmark-dark.webp';
import watercolor from '../assets/hero/watercolor.webp?url';
import watercolorEdge from '../assets/hero/watercolor-edge.svg?url';
import Container from './Container.astro';

const year = new Date().getFullYear();
const links = [
  { label: 'X / Twitter', icon: 'twitter', url: 'https://x.com/ParallX_AI' },
  { label: 'Bluesky', icon: 'bluesky', url: 'https://bsky.app/profile/parallx.ai' },
  { label: 'GitHub', icon: 'github', url: 'https://github.com/parallx-ai' },
  { label: 'Hugging Face', icon: 'huggingface', url: 'https://huggingface.co/parallx-ai' },
  { label: 'Email', icon: 'email', url: 'mailto:info@parallx.ai' },
];
---
<footer class="site-footer" style={`--footer-watercolor: url('${watercolor}'); --footer-edge: url(${JSON.stringify(watercolorEdge)})`}>
  <div class="footer-landscape" aria-hidden="true"></div>
  <svg class="footer-orbit" viewBox="0 0 1100 250" preserveAspectRatio="none" fill="none" aria-hidden="true"><path d="M-30 184C222 22 396 309 717 144S1025 47 1170 95" stroke="currentColor" stroke-width="0.9" stroke-dasharray="0.8 4" stroke-linecap="round" /><circle cx="717" cy="144" r="3" fill="currentColor" /></svg>
  <Container class="relative z-10">
    <div class="footer-main">
      <a href="/" aria-label="Parallax home" class="footer-brand"><Image src={wordmark} alt="" width={180} densities={[1, 2]} loading="lazy" class="block h-auto w-full" /></a>
      <nav class="footer-navigation" aria-label="Footer">
        <a href="/about.html">About</a>
        <a href="/careers.html">Join us</a>
        <a href="mailto:info@parallx.ai">Get in touch</a>
      </nav>
    </div>
    <div class="footer-bottom">
      <p class="footer-legal">© {year} Parallax. All rights reserved. Parallax is a project of <a href="https://www.meridiancambridge.org/" rel="noopener" target="_blank">Meridian Impact CIC</a>, a UK not-for-profit community interest company (CN: 13653958) with US 501(c)(3) equivalency.</p>
      <ul class="footer-socials" aria-label="Parallax links">
        {links.map((link) => (
          <li><a href={link.url} rel={link.url.startsWith('mailto:') ? undefined : 'noopener'} target={link.url.startsWith('mailto:') ? undefined : '_blank'} aria-label={link.label} title={link.label}>
            <svg class:list={[link.icon === 'twitter' ? 'h-[15px] w-[15px]' : 'h-[17px] w-[17px]']} aria-hidden="true"><use href={`#icon-${link.icon}`} /></svg>
          </a></li>
        ))}
      </ul>
    </div>
  </Container>
</footer>

<style>
  .site-footer { position: relative; isolation: isolate; overflow: hidden; padding-top: 64px; color: #eee7d8; }
  .footer-landscape { position: absolute; inset: 0; z-index: -2; background: #151c19; mask: var(--footer-edge) center / 100% 100% no-repeat; }
  .footer-landscape::before { content: ''; position: absolute; inset: 0; background: var(--footer-watercolor) center bottom / cover; filter: invert(1) grayscale(1) sepia(0.2) hue-rotate(145deg) saturate(0.5); opacity: 0.45; }
  .footer-landscape::after { content: ''; position: absolute; inset: 0; background: linear-gradient(#151c1966, #1016121a 25%, #030504c7 60%, #000 90%); }
  .footer-orbit { position: absolute; inset: auto 0 20px; width: 100%; height: 140px; color: #cfac67; opacity: 0.36; pointer-events: none; }
  .footer-main { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-bottom: 24px; }
  .footer-brand { display: block; width: 160px; max-width: 55%; }
  .footer-navigation { display: flex; flex-wrap: wrap; gap: 12px 24px; font-size: 15px; }
  .footer-navigation a { color: #eee7d8; text-decoration: none; transition: color 180ms; }
  .footer-navigation a:hover { color: #efcc82; }
  .footer-bottom { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 16px 0 20px; border-top: 1px solid #ccae7040; }
  .footer-legal { max-width: 660px; margin: 0; font-size: 12px; line-height: 1.7; color: #d0d0c4; }
  .footer-legal a { color: inherit; text-decoration: underline; text-decoration-color: #c9bfa06b; text-underline-offset: 3px; }
  .footer-legal a:hover { color: #efcc82; }
  .footer-socials { display: flex; align-items: center; flex-shrink: 0; gap: 5px; margin: 0; padding: 0; list-style: none; }
  .footer-socials a { display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; color: #e1dacb; border-radius: 50%; transition: color 180ms, background 180ms; }
  .footer-socials a:hover { color: #efcc82; background: #ccae701c; }
  @media (max-width: 600px) {
    .site-footer { padding-top: 60px; }
    .footer-main { flex-direction: column; gap: 16px; padding-bottom: 20px; }
    .footer-brand { width: 140px; max-width: 80%; }
    .footer-navigation { justify-content: center; gap: 20px; font-size: 14px; }
    .footer-bottom { flex-direction: column-reverse; gap: 10px; text-align: center; padding-top: 14px; }
    .footer-landscape::before { background-position: 70% bottom; }
  }
</style>
