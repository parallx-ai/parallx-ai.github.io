---
import Container from './Container.astro';
import NewsletterSignup from './NewsletterSignup.astro';

interface NewsItem {
  title: string;
  date: string;
  summary: string;
  href: string;
}

interface Props {
  items: NewsItem[];
}

const { items } = Astro.props;
---

<section id="news" class="scroll-mt-[76px] bg-paper py-24 max-nav:py-16">
  <Container>
    <div class="grid grid-cols-[1fr_2fr] items-start gap-[60px] max-nav:grid-cols-1 max-nav:gap-8">
      <div>
        <h2 class="font-display text-[clamp(30px,3.5vw,46px)] font-semibold leading-[1.05] tracking-[-0.035em]">News</h2>
        <div class="mt-8">
          <NewsletterSignup />
        </div>
      </div>

      <div class="border-t border-rule">
        {items.map((item) => (
          <a
            href={item.href}
            class="group/news grid grid-cols-[112px_1fr_auto] gap-6 border-b border-rule-soft py-8 text-ink transition-colors hover:text-gold-deep max-xs:grid-cols-[1fr_auto] max-xs:gap-x-4 max-xs:gap-y-2 max-xs:py-6"
          >
            <time class="pt-1 text-[14px] text-ink-2 max-xs:col-span-2">{item.date}</time>
            <div>
              <h3 class="font-display text-[clamp(24px,2.4vw,30px)] font-semibold leading-[1.2] tracking-[-0.025em]">{item.title}</h3>
              <p class="mt-2 max-w-[58ch] text-[clamp(16px,1.4vw,18px)] leading-[1.5] text-ink-1">{item.summary}</p>
            </div>
            <span class="pt-1 text-[24px] leading-none transition-transform group-hover/news:translate-x-1" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </Container>
</section>
