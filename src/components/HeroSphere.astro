---
interface Props {
  index: number;
  x: number;
  y: number;
  size: number;
  duration: number;
  delay: number;
}
const { index, x, y, size, duration, delay } = Astro.props;
const coreRing = { radius: 16, strokeWidth: 0.7 };
const nodeStrokeWidth = 1.2;
const branchNodeRadius = 1.2;
let seed = 8191 + index * 137;
const random = () => {
  seed = (seed * 16807) % 2147483647;
  return (seed - 1) / 2147483646;
};
const polar = (angle: number, radius: number): [number, number] => [100 + Math.cos(angle) * radius, 100 + Math.sin(angle) * radius];
const point = ([px, py]: [number, number]) => `${px.toFixed(2)},${py.toFixed(2)}`;
// Eight banks of branching, 45-degree traces follow the banner's circuitry.
const circuits = Array.from({ length: 32 }, (_, i) => {
  const angle = Math.floor(i / 4) * Math.PI / 4;
  const lane = (i % 4) - 1.5;
  const direction = Math.sign(lane);
  const reach = 61 + random() * 20;
  const middle = 26 + random() * 14;
  const bend = 8 + Math.abs(lane) * 6;
  const rotate = (px: number, py: number): [number, number] => [100 + px * Math.cos(angle) - py * Math.sin(angle), 100 + px * Math.sin(angle) + py * Math.cos(angle)];
  const points = [polar(angle + lane * 0.21, 15), rotate(middle, lane * 3), rotate(middle + bend, lane * 3 + direction * bend), rotate(reach, lane * 3 + direction * bend)];
  const end = points[points.length - 1];
  const branchEnd = rotate(reach - 10, lane * 3 + direction * (bend + 7));
  return {
    path: `M${points.map(point).join(' L')}`,
    branch: `M${point(points[2])} L${point(rotate(middle + bend + 7, lane * 3 + direction * (bend + 7)))} L${point(branchEnd)}`,
    end,
    branchEnd,
    nodeRadius: i % 3 === 0 ? 2.3 : 1.5,
    opacity: 0.52 + random() * 0.46,
  };
});
const id = `sphere-${index}`;
---

<div class={`sphere-position sphere-position-${index}`} style={`--x:${x}%;--y:${y}%;--size:${size}px;--duration:${duration}s;--delay:${delay}s;`}>
  <div class="sphere-float">
    <svg class="sphere-orbital" viewBox="0 0 240 240" fill="none" aria-hidden="true">
      <circle cx="120" cy="120" r="111" stroke="currentColor" stroke-width="1.2" stroke-dasharray="0.6 3.6" stroke-linecap="round" />
      <ellipse cx="120" cy="120" rx="115" ry="104" stroke="currentColor" stroke-width="0.8" opacity="0.6" transform={`rotate(${index * 23 - 28} 120 120)`} />
      <circle cx="120" cy="9" r="1.8" fill="currentColor" />
    </svg>
    <button class="hero-sphere" type="button" aria-label={`Reveal the golden circuitry inside sphere ${index + 1}`} aria-pressed="false">
      <span class="sphere-glass" aria-hidden="true"></span>
      <svg class="sphere-circuitry" viewBox="0 0 200 200" fill="none" aria-hidden="true">
        <defs>
          <radialGradient id={`${id}-core`}>
            <stop stop-color="#fff2c5" />
            <stop offset="0.45" stop-color="#efd08a" />
            <stop offset="1" stop-color="#be9046" />
          </radialGradient>
          <radialGradient id={`${id}-glow`}>
            <stop stop-color="#e9bc65" stop-opacity="0.3" />
            <stop offset="1" stop-color="#e9bc65" stop-opacity="0" />
          </radialGradient>
          <!-- Trim the visible stroke, including round caps and moving signals,
               to the outer edges of the node outlines and the core ring. -->
          <mask id={`${id}-trace-boundary`} maskUnits="userSpaceOnUse" x="0" y="0" width="200" height="200" style="mask-type: luminance">
            <rect width="200" height="200" fill="white" />
            <circle cx="100" cy="100" r={coreRing.radius + coreRing.strokeWidth / 2} fill="black" />
            {circuits.map(({ end, branchEnd, nodeRadius }, i) => (
              <>
                <circle cx={end[0]} cy={end[1]} r={nodeRadius + nodeStrokeWidth / 2} fill="black" />
                {i % 2 === 0 && <circle cx={branchEnd[0]} cy={branchEnd[1]} r={branchNodeRadius + nodeStrokeWidth / 2} fill="black" />}
              </>
            ))}
          </mask>
        </defs>
        <circle cx="100" cy="100" r="80" fill={`url(#${id}-glow)`} />
        <g class="circuit-traces" mask={`url(#${id}-trace-boundary)`}>
          <g class="circuit-depth" stroke="#dac08a" stroke-width="0.55" opacity="0.24">
            {circuits.map(({ path }) => <path d={path} transform="translate(13 7) scale(0.87)" />)}
          </g>
          <g stroke="#ebc57d" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
            {circuits.map(({ path, branch, opacity }, i) => (
              <g opacity={opacity}>
                <path d={path} />
                {i % 2 === 0 && <path d={branch} stroke-width="0.65" opacity="0.7" />}
              </g>
            ))}
          </g>
          <g stroke="#fff0bc" stroke-width="1.7" stroke-linecap="round">
            {circuits.filter((_, i) => i % 3 === 0).map(({ path }, i) => <path class="circuit-signal" d={path} pathLength="100" style={`--signal-delay:${-i * 0.63}s;`} />)}
          </g>
        </g>
        <g class="circuit-nodes" stroke="#ebc57d" stroke-width={nodeStrokeWidth}>
          {circuits.map(({ end, branchEnd, nodeRadius, opacity }, i) => (
            <g opacity={opacity}>
              <circle cx={end[0]} cy={end[1]} r={nodeRadius} fill="#9a804b" fill-opacity="0.25" />
              {i % 2 === 0 && <circle cx={branchEnd[0]} cy={branchEnd[1]} r={branchNodeRadius} />}
            </g>
          ))}
        </g>
        <g stroke="#ebc581">
          <circle cx="100" cy="100" r={coreRing.radius} stroke-width={coreRing.strokeWidth} stroke-dasharray="19 3 7 3" />
          <circle cx="100" cy="100" r="12.5" stroke-width="1.4" />
          <circle cx="100" cy="100" r="9" fill={`url(#${id}-core)`} stroke-width="1" />
        </g>
      </svg>
      <svg class="sphere-shell" viewBox="0 0 200 200" aria-hidden="true">
        <defs>
          <radialGradient id={`${id}-ink`} cx="36%" cy="30%" r="72%">
            <stop stop-color="var(--sphere-highlight)" />
            <stop offset="0.38" stop-color="var(--sphere-midtone)" />
            <stop offset="0.73" stop-color="var(--sphere-shadow)" />
            <stop offset="1" stop-color="var(--sphere-edge)" />
          </radialGradient>
          <radialGradient id={`${id}-bleed`}>
            <stop offset="0.86" stop-color="white" />
            <stop offset="0.94" stop-color="white" stop-opacity="0.85" />
            <stop offset="1" stop-color="white" stop-opacity="0" />
          </radialGradient>
          <mask id={`${id}-edge`}><circle cx="100" cy="100" r="100" fill={`url(#${id}-bleed)`} /></mask>
          <filter id={`${id}-pigment`} x="-10%" y="-10%" width="120%" height="120%" color-interpolation-filters="sRGB">
            <feTurbulence type="fractalNoise" baseFrequency="0.07 0.1" numOctaves="3" seed={index + 11} result="pigment" />
            <feColorMatrix in="pigment" type="saturate" values="0" />
            <feComponentTransfer result="grain">
              <feFuncR type="table" tableValues="0.3 0.65" />
              <feFuncG type="table" tableValues="0.31 0.65" />
              <feFuncB type="table" tableValues="0.29 0.61" />
              <feFuncA type="table" tableValues="0.38 0.38" />
            </feComponentTransfer>
            <feComposite in="grain" in2="SourceGraphic" operator="in" result="clipped-grain" />
            <feBlend in="SourceGraphic" in2="clipped-grain" mode="soft-light" />
            <feDisplacementMap in2="pigment" scale="3.5" xChannelSelector="R" yChannelSelector="G" />
            <feGaussianBlur stdDeviation="0.6" />
          </filter>
        </defs>
        <g mask={`url(#${id}-edge)`}>
          <g filter={`url(#${id}-pigment)`}>
            <circle cx="100" cy="100" r="99" fill={`url(#${id}-ink)`} />
            <path d="M13 89C39 23 85 20 132 35S189 109 160 139C141 91 96 77 75 102S32 130 13 89Z" fill="#abb19b" opacity="0.05" transform={`rotate(${index * 47} 100 100)`} />
            <path d="M9 120C54 81 91 132 116 110S165 52 194 82L185 155C143 200 54 195 9 120Z" fill="#101a15" opacity="0.08" transform={`rotate(${index * 31} 100 100)`} />
          </g>
        </g>
      </svg>
      <span class="sphere-rim" aria-hidden="true"></span>
    </button>
  </div>
</div>

<style>
  .sphere-position {
    --sphere-highlight: #2c302d;
    --sphere-midtone: #171f1b;
    --sphere-shadow: #0c1310;
    --sphere-edge: #242d25;
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--size);
    height: var(--size);
    transform: translate(-50%, -50%);
  }
  :global(html.dark) .sphere-position {
    --sphere-highlight: #b7b7a6;
    --sphere-midtone: #949985;
    --sphere-shadow: #6f7d6c;
    --sphere-edge: #a2a88f;
  }
  .sphere-float {
    width: 100%;
    height: 100%;
    animation: float var(--duration) ease-in-out var(--delay) infinite;
    animation-play-state: paused;
  }
  .sphere-orbital {
    position: absolute;
    width: 124%;
    height: 124%;
    left: -12%;
    top: -12%;
    color: #b58a39;
    opacity: 0.86;
    pointer-events: none;
  }
  .sphere-orbital circle, .sphere-orbital ellipse { vector-effect: non-scaling-stroke; }
  :global(html.dark) .sphere-orbital { color: #ddbd7c; opacity: 0.9; }
  .hero-sphere {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sphere-shell, .sphere-glass, .sphere-rim, .sphere-circuitry { position: absolute; inset: 0; border-radius: 50%; pointer-events: none; }
  .sphere-glass {
    /* Solid interior hides the orbit paths while the outer edge stays soft. */
    background: radial-gradient(circle at 35% 30%, #b1b5a6 0%, #4e5752 39%, #26312c 72%, #c9c8b7 100%);
    mask-image: radial-gradient(circle closest-side, #000 95%, transparent 100%);
    filter: blur(0.5px);
  }
  .sphere-shell {
    width: 100%;
    height: 100%;
    transition: opacity 850ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sphere-rim {
    inset: -2%;
    background: radial-gradient(circle closest-side, transparent 92%, #c3aa7759 96%, transparent 100%);
    opacity: 0.18;
    filter: blur(0.8px);
    transition: opacity 650ms;
  }
  .sphere-circuitry {
    width: 100%;
    height: 100%;
    opacity: 0;
    transform: rotate(-9deg) scale(0.91);
    transition: opacity 650ms ease, transform 1400ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .circuit-signal {
    stroke-dasharray: 3 97;
    animation: signal 6s linear var(--signal-delay) infinite;
    animation-play-state: paused;
  }
  .hero-sphere:focus-visible { outline: 2px solid #aa8236; outline-offset: 9px; }
  .hero-sphere[data-active="true"] { transform: scale(1.12); }
  .hero-sphere[data-revealed="true"] .sphere-shell { opacity: 0.04; }
  .hero-sphere[data-revealed="true"] .sphere-circuitry { opacity: 1; transform: rotate(0) scale(1); }
  .hero-sphere[data-revealed="true"] .sphere-rim { opacity: 0.85; }
  :global(#hero[data-running="true"]) .sphere-float { animation-play-state: running; }
  :global(#hero[data-running="true"]) .hero-sphere[data-revealed="true"] .circuit-signal { animation-play-state: running; }
  .sphere-float:has(.hero-sphere[data-active="true"]) { animation-play-state: paused !important; }
  @keyframes float {
    0%, 100% { transform: translate(0, 0) rotate(-3deg); }
    35% { transform: translate(12px, -17px) rotate(2deg); }
    70% { transform: translate(-9px, 9px) rotate(-1deg); }
  }
  @keyframes signal { from { stroke-dashoffset: 100; } to { stroke-dashoffset: 0; } }
  @media (max-width: 1180px) and (min-width: 601px) {
    .sphere-position { width: calc(var(--size) * 0.8); height: calc(var(--size) * 0.8); }
    .sphere-position-0 { top: 20%; }
    .sphere-position-3 { top: 28%; }
    .sphere-position-4 { top: 79%; }
    .sphere-position-6 { top: 82%; }
  }
  @media (max-width: 600px) {
    .sphere-position { width: calc(var(--size) * 0.72); height: calc(var(--size) * 0.72); }
    .sphere-position-0 { left: 15%; top: 16%; }
    .sphere-position-2 { left: 78%; top: 12%; }
    .sphere-position-4 { left: 72%; top: 77%; width: 138px; height: 138px; }
    .sphere-position-6 { left: 19%; top: 80%; }
    .sphere-position-1, .sphere-position-3, .sphere-position-5, .sphere-position-7 { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sphere-float, .circuit-signal { animation: none; }
    .hero-sphere, .sphere-shell, .sphere-circuitry, .sphere-rim { transition: none; }
  }
</style>
