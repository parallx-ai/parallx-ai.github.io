---
interface Props { count: number; }
const { count } = Astro.props;
---

<svg class="hero-rays" fill="none" aria-hidden="true">
  <defs>
    <linearGradient id="hero-ray-gold" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="var(--ray-gold-edge)" />
      <stop offset="0.55" stop-color="var(--ray-gold-light)" />
      <stop offset="1" stop-color="var(--ray-gold-edge)" />
    </linearGradient>
    {Array.from({ length: count }, (_, index) => (
      <>
        <mask id={`hero-ray-${index}-incoming`} maskUnits="userSpaceOnUse" x="0" y="0" width="100%" height="100%" style="mask-type: alpha">
          <path class="ray-travel ray-incoming-travel" data-ray-travel={index} pathLength="1" />
        </mask>
        {[0, 1].map((branch) => (
          <mask id={`hero-ray-${index}-branch-${branch}`} maskUnits="userSpaceOnUse" x="0" y="0" width="100%" height="100%" style="mask-type: alpha">
            <path class="ray-travel ray-branch-travel" data-ray-travel={index} pathLength="1" />
          </mask>
        ))}
      </>
    ))}
  </defs>
  <g mask="url(#orbit-reading-mask)">
    {Array.from({ length: count }, (_, index) => (
      <g class="hero-ray" data-ray={index} opacity="0">
        <path class="ray-incoming" mask={`url(#hero-ray-${index}-incoming)`} />
        {[0, 1].map((branch) => (
          <path class="ray-branch" mask={`url(#hero-ray-${index}-branch-${branch})`} />
        ))}
        <circle class="ray-impact" r="4" />
      </g>
    ))}
  </g>
</svg>

<style>
  .hero-rays {
    --ray-gold-edge: #c3932d;
    --ray-gold-light: #efc572;
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .hero-ray path {
    fill: url(#hero-ray-gold);
  }
  .ray-travel {
    fill: none;
    stroke: white;
    stroke-linecap: butt;
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
  }
  .ray-impact { fill: #fff0bc; opacity: 0; filter: drop-shadow(0 0 4px #edc56c); }
  :global(html.dark) .hero-rays {
    --ray-gold-edge: #d9aa51;
    --ray-gold-light: #f3d78e;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-rays { display: none; }
  }
</style>
