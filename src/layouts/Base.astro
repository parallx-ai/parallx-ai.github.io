---
import '../styles/global.css';
import { Font } from 'astro:assets';
import IconSprite from '../components/IconSprite.astro';
import BackToTop from '../components/BackToTop.astro';
import faviconUrl from '../assets/logos/mark-light-bg.webp?url';
import socialBanner from '../assets/social-banner.png';

interface Props {
  title: string;
  description: string;
  screenLabel?: string;
}
const { title, description, screenLabel = 'Home' } = Astro.props;
const siteOrigin = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin);
const socialPreview = new URL(socialBanner.src, siteOrigin);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Parallax" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialPreview} />
    <meta property="og:image:width" content={String(socialBanner.width)} />
    <meta property="og:image:height" content={String(socialBanner.height)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Parallax — a deeper look at AI agent evaluations" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ParallX_AI" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialPreview} />
    <meta name="twitter:image:alt" content="Parallax — a deeper look at AI agent evaluations" />
    <link rel="icon" type="image/webp" href={faviconUrl} />
    <Font cssVariable="--font-body" preload={[{ weight: 400 }, { weight: 600 }]} />
    <script is:inline>
      // Apply the saved or system theme before paint to avoid a flash.
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && systemDark)) {
            document.documentElement.classList.add('dark');
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body data-screen-label={screenLabel}>
    <IconSprite />
    <slot />
    <BackToTop />
  </body>
</html>
