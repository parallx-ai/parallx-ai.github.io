---
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
import Hero from '../components/Hero.astro';
import ResearchList from '../components/ResearchList.astro';
import NewsList from '../components/NewsList.astro';
import PeopleGroups from '../components/PeopleGroups.astro';
import Collaborators from '../components/Collaborators.astro';
import Container from '../components/Container.astro';
import SiteFooter from '../components/SiteFooter.astro';

import publications from '../data/publications.json';
import tools from '../data/tools.json';
import news from '../data/news.json';

// Our Work renders publications and tools as a single
// list of cards. Only entries with `featured: true` are surfaced here.
// Publications expose `abstract`, tools expose `summary` — normalise to
// a shared `text` field so one card markup handles both.
const research = [
  ...publications.filter((p) => p.featured).map((p) => ({ ...p, text: p.abstract })),
  ...tools.filter((t) => t.featured).map((t) => ({ ...t, text: t.summary, venue: '' })),
];
---
<Base
  title="Parallax"
  description="Parallax is a non-profit research lab building the science of belief elicitation for white-box auditing of frontier AI agents."
  screenLabel="Home"
>
  <SiteNav />
  <Hero />
  <ResearchList items={research} />
  <NewsList items={news} />
  <section class="py-24 max-nav:py-16">
    <Container>
      <PeopleGroups headingLevel={2} />
      <Collaborators class="mt-28 max-xs:mt-20" />
    </Container>
  </section>
  <SiteFooter />
</Base>
